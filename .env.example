# Database
POSTGRES_URL=postgresql://user:password@localhost:5432/ai_chatbot

# Auth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-at-least-32-characters
# Local self-hosting only; Vercel trusts its host automatically.
AUTH_TRUST_HOST=true

# AI provider
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Embedding 服务（阿里云百炼 / DashScope）
# 真实 Key 只填写在 .env.local 中，不要提交到 Git。
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
# 把 your-workspace-id 替换成百炼控制台中的 WorkspaceId。
DASHSCOPE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# Public image storage (Vercel Blob server-side upload)
BLOB_READ_WRITE_TOKEN=replace-with-your-vercel-blob-token
